@model LuckySpin.ViewModels.PlayersChoice
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using LuckySpin.Models;

@{
    Layout = "_Layout";
}

<h1>Lucky Spin</h1>
<h2>Players Choice</h2>

<form asp-action="PlayersChoice" asp-controller="Spinner" method="post">
    <fieldset>
        <label>Select a Player:</label>

        <select asp-for="SelectedPlayerId">
            <option value="">-- Choose a player --</option>
            @foreach (Player p in Model.Players)
            {
                <option value="@p.Id">
                    @p.FirstName (Luck: @p.Luck)
                </option>
            }
        </select>
    </fieldset>

    <input type="submit" value="Play Game" />
</form>

<hr />

<h2>Best Previous Games</h2>
<table>
    <thead>
        <tr>
            <th>Game</th>
            <th>Player</th>
            <th>Number of Spins</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Game g in Model.Games)
        {
            <tr>
                <td>@g.Id</td>
                <td>@g.Player?.FirstName</td>
                <td>@(g.Spins?.Count ?? 0)</td>
            </tr>
        }
    </tbody>
</table>
